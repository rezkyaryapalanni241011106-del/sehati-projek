NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_sehati

JWT_SECRET=ganti_dengan_random_string_panjang_minimal_64_karakter
JWT_EXPIRES_IN=15m
SESSION_SECRET=ganti_dengan_random_string_panjang_minimal_64_karakter

BCRYPT_ROUNDS=12

OTP_MOCK=true
OTP_EXPIRY_MINUTES=5

# ── WhatsApp Provider ─────────────────────────────────────────
# Pilih provider: 'meta' (WhatsApp Cloud API resmi) atau 'fonnte'
WA_PROVIDER=

# Fonnte — aktif jika WA_PROVIDER=fonnte
FONNTE_TOKEN=

# WhatsApp Cloud API (Meta) — aktif jika WA_PROVIDER=meta
# Cara dapatkan: developers.facebook.com → App SEHATI → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=ISI_PHONE_NUMBER_ID_ANDA
WA_ACCESS_TOKEN=ISI_ACCESS_TOKEN_ANDA
WA_TEMPLATE_NAME=otp_sehati
WA_TEMPLATE_LANGUAGE=id
# true  = template punya tombol "Copy Code"
# false = template hanya teks saja
WA_TEMPLATE_HAS_BUTTON=true

UPLOAD_PATH=src/public/uploads
MAX_FILE_SIZE_MB=10

APP_NAME=SEHATI
CLINIC_NAME=Klinik Sehat Bersama
CLINIC_ADDRESS=Jl. Pemuda.Pare-Pare
CLINIC_PHONE=(021) 1234-5678
