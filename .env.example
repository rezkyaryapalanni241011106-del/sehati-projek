NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_sehati

JWT_SECRET=ganti_dengan_random_string_panjang_minimal_64_karakter
JWT_EXPIRES_IN=15m
SESSION_SECRET=ganti_dengan_random_string_panjang_minimal_64_karakter

BCRYPT_ROUNDS=12

OTP_MOCK=true
OTP_EXPIRY_MINUTES=5

# WhatsApp via Fonnte (https://fonnte.com)
# Set OTP_MOCK=false dan isi FONNTE_TOKEN untuk pengiriman nyata
FONNTE_TOKEN=

UPLOAD_PATH=src/public/uploads
MAX_FILE_SIZE_MB=10

APP_NAME=SEHATI
CLINIC_NAME=Klinik Sehat Bersama
CLINIC_ADDRESS=Jl. Kesehatan No. 1, Jakarta
CLINIC_PHONE=(021) 1234-5678
