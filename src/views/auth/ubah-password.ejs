<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ubah Password · SEHATI</title>
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/medis.css">
  <link rel="stylesheet" href="/public/css/sehati.css">
</head>
<body>
<div style="min-height:100vh; display:flex; align-items:center; justify-content:center; background:var(--bg-soft); padding:24px;">
  <div style="width:100%; max-width:460px;">
    <div class="card card-padded" style="padding:36px 40px;">
      <div class="eyebrow" style="margin-bottom:6px;">PENGATURAN AKUN</div>
      <h1 style="margin:0 0 6px; font-size:24px;">Ubah Password</h1>
      <p class="muted" style="margin:0 0 24px; font-size:14px;">
        <% const namaMap = {super_admin:'Super Admin', admin:'Admin', dokter:'Dokter', perawat:'Perawat', resepsionis:'Resepsionis'}; %>
        <%= user ? user.nama : '' %> · <%= user ? (namaMap[user.peran] || user.peran) : '' %>
      </p>

      <% if (locals.flash_success) { %>
        <div class="flash success"><%= flash_success %></div>
      <% } %>
      <% if (locals.flash_error) { %>
        <div class="flash error"><%= flash_error %></div>
      <% } %>

      <form method="POST" action="/auth/ubah-password">
        <div class="form-group" style="margin-bottom:16px;">
          <label class="form-label">Password Lama</label>
          <input type="password" name="password_lama" class="form-input" required autocomplete="current-password">
        </div>
        <div class="form-group" style="margin-bottom:16px;">
          <label class="form-label">Password Baru</label>
          <input type="password" name="password_baru" class="form-input" required minlength="8" autocomplete="new-password">
          <div class="form-hint">Minimal 8 karakter</div>
        </div>
        <div class="form-group" style="margin-bottom:28px;">
          <label class="form-label">Konfirmasi Password Baru</label>
          <input type="password" name="konfirmasi_baru" class="form-input" required minlength="8" autocomplete="new-password">
        </div>
        <div style="display:flex; gap:12px; align-items:center;">
          <button type="submit" class="btn btn-primary">Simpan Password</button>
          <% const backMap = {super_admin:'/audit', admin:'/admin', dokter:'/antrian', perawat:'/kedatangan', resepsionis:'/kedatangan'}; %>
          <a href="<%= (locals.user && backMap[user.peran]) || '/auth/login' %>" class="back-link">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
            Kembali
          </a>
        </div>
      </form>
    </div>
  </div>
</div>
</body>
</html>
