<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Setup MFA · SEHATI</title>
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/patient.css">
  <link rel="stylesheet" href="/public/css/sehati.css">
  <style>
    .mfa-step-label {
      font-size: 13px;
      font-weight: 700;
      margin-bottom: 6px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .mfa-step-num {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: var(--accent);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .mfa-step-sep {
      font-size: 12px;
      color: var(--ink-muted);
      font-weight: 400;
    }
    .mfa-qr-box {
      text-align: center;
      padding: 20px;
      background: #fff;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      margin-top: 10px;
    }
    .mfa-secret {
      background: var(--bg-soft);
      padding: 12px 16px;
      border-radius: var(--radius);
      font-family: var(--font-mono);
      font-size: 14px;
      letter-spacing: 3px;
      text-align: center;
      user-select: all;
      margin-top: 10px;
      word-break: break-all;
      border: 1px solid var(--border-soft);
    }
    .mfa-steps { display: flex; flex-direction: column; gap: 20px; }
    .mfa-step { border-left: 2px solid var(--border-soft); padding-left: 16px; }
  </style>
</head>
<body>
<header class="topbar">
  <a class="logo" href="/">
    <span class="logo-mark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21.5 5 23 9 21.5 12.5 19 16.65 12 21 12 21z"></path></svg>
    </span>
    <span class="logo-text">SEHATI<span class="sub">RME</span></span>
  </a>
  <span class="chip">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
    Keamanan Akun
  </span>
</header>

<main class="center-page">
  <div class="auth-card" style="max-width:480px;">
    <div class="eyebrow">TENAGA MEDIS &amp; STAF · SETUP MFA</div>
    <h1>Setup Autentikator</h1>
    <p class="lede">Aktifkan autentikasi dua faktor untuk keamanan akun Anda.</p>

    <% if (locals.flash_info) { %>
      <div class="alert alert-info" style="margin-bottom:16px;"><%= flash_info %></div>
    <% } %>
    <% if (locals.flash_error) { %>
      <div class="alert alert-warning" style="margin-bottom:16px;"><%= flash_error %></div>
    <% } %>
    <% if (locals.flash_success) { %>
      <div class="alert alert-success" style="margin-bottom:16px;"><%= flash_success %></div>
    <% } %>

    <div class="mfa-steps">
      <div class="mfa-step">
        <div class="mfa-step-label">
          <span class="mfa-step-num">1</span>
          Scan QR Code
          <span class="mfa-step-sep">· Google Authenticator, Authy, atau TOTP lainnya</span>
        </div>
        <div class="mfa-qr-box">
          <img src="<%= qr_data_url %>" alt="QR Code MFA" style="max-width:200px; width:100%;">
        </div>
      </div>

      <div class="mfa-step">
        <div class="mfa-step-label">
          <span class="mfa-step-num">2</span>
          Atau masukkan secret manual
        </div>
        <div class="mfa-secret"><%= totp_secret %></div>
      </div>

      <div class="mfa-step">
        <div class="mfa-step-label">
          <span class="mfa-step-num">3</span>
          Konfirmasi kode dari aplikasi
        </div>
        <form method="POST" action="/auth/setup-mfa/verify" style="margin-top:10px;">
          <div class="form-group" style="margin-bottom:12px;">
            <input class="form-input" type="text" name="totp_kode" maxlength="6" pattern="[0-9]{6}"
              placeholder="000000" autocomplete="one-time-code" inputmode="numeric" required
              style="font-size:22px; letter-spacing:10px; text-align:center;">
          </div>
          <button class="btn btn-primary btn-block" type="submit">Verifikasi &amp; Aktifkan</button>
        </form>
      </div>
    </div>

    <div class="divider"></div>
    <p class="tiny muted" style="text-align:center;">
      <a href="/auth/logout" class="back-link">Batal &amp; keluar</a>
    </p>
  </div>
</main>
</body>
</html>
