<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kelola Spesialisasi · SEHATI Admin</title>
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/medis.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <link rel="stylesheet" href="/public/css/sehati.css">
</head>
<body>
<div class="app-shell admin">
  <aside class="sidebar admin">
    <div class="sidebar-brand">
      <span class="logo-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21.5 5 23 9 21.5 12.5 19 16.65 12 21 12 21z"></path></svg>
      </span>
      <div class="brand-text">
        SEHATI Admin Portal
        <span class="sub">Akun Staf · Jadwal Praktek</span>
      </div>
    </div>

    <div class="sidebar-section" style="color:var(--admin);">Admin</div>
    <a href="/admin" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      Ringkasan
    </a>
    <a href="/akun/staf" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
      Akun Tenaga Medis
    </a>
    <a href="/jadwal" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
      Jadwal Praktek
    </a>
    <a href="/spesialisasi" class="nav-item active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
      Spesialisasi
    </a>

    <div class="sidebar-footer">
      <a href="/auth/logout" class="logout-btn">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Keluar sesi
      </a>
    </div>
  </aside>

  <section class="main">
    <div class="main-topbar">
      <div class="searchbox">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" placeholder="Cari akun, log, jadwal…">
      </div>
      <div class="right-tools">
        <div class="user-chip">
          <span class="avatar" style="background:#f8eaea; color:var(--admin);"><%= user.nama.split(' ').map(w=>w[0]).join('').substring(0,2).toUpperCase() %></span>
          <div>
            <div class="user-name"><%= user.nama %></div>
            <div class="user-role">Admin</div>
          </div>
        </div>
      </div>
    </div>

    <div class="main-content">
      <% if (locals.flash_success) { %><div class="flash success"><%= flash_success %></div><% } %>
      <% if (locals.flash_error) { %><div class="flash error"><%= flash_error %></div><% } %>

      <div class="page-head">
        <div>
          <div class="meta">Master Data</div>
          <h1>Kelola Spesialisasi</h1>
        </div>
        <a class="back-link" href="/akun/staf">← Akun Tenaga Medis</a>
      </div>

      <div class="card card-padded" style="margin-bottom:18px;">
        <h3 style="margin-bottom:14px;">Tambah Spesialisasi</h3>
        <form method="POST" action="/spesialisasi/create" style="display:flex; gap:8px; align-items:flex-end;">
          <div class="form-group" style="flex:1; margin:0;">
            <label class="form-label">Nama spesialisasi *</label>
            <input class="form-input" name="nama" placeholder="mis. Penyakit Dalam" required>
          </div>
          <button class="btn btn-primary">Tambah</button>
        </form>
      </div>

      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Spesialisasi</th>
              <th>Dipakai</th>
              <th>Status</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            <% if (!list || list.length === 0) { %>
              <tr><td colspan="4" class="muted" style="text-align:center; padding:28px;">Belum ada spesialisasi.</td></tr>
            <% } else { list.forEach(function(s) { %>
              <tr>
                <td><%= s.nama %></td>
                <td class="tiny muted"><%= s.dipakai %> dokter</td>
                <td><span class="badge badge-<%= s.status_aktif ? 'ringan' : 'kritis' %>"><%= s.status_aktif ? 'Aktif' : 'Nonaktif' %></span></td>
                <td class="aksi-cell" style="white-space:nowrap;">
                  <form method="POST" action="/spesialisasi/<%= s.id %>/toggle" style="display:inline; margin:0;">
                    <button class="back-link" style="border:none; cursor:pointer;"><%= s.status_aktif ? 'Nonaktifkan' : 'Aktifkan' %></button>
                  </form>
                  <form method="POST" action="/spesialisasi/<%= s.id %>/delete" style="display:inline; margin:0;" onsubmit="return confirm('Hapus spesialisasi ini?');">
                    <button class="back-link" style="border:none; cursor:pointer; color:var(--kritis);">Hapus</button>
                  </form>
                </td>
              </tr>
            <% }); } %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>
</body>
</html>
