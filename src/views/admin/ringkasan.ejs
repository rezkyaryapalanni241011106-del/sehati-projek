<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Ringkasan · SEHATI Admin</title>
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/medis.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <link rel="stylesheet" href="/public/css/sehati.css">
</head>
<% const isSuperAdmin = user && user.peran === 'super_admin'; %>
<body>
<div class="app-shell admin">
  <aside class="sidebar admin">
    <div class="sidebar-brand">
      <span class="logo-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21.5 5 23 9 21.5 12.5 19 16.65 12 21 12 21z"></path></svg>
      </span>
      <div class="brand-text">
        <% if (isSuperAdmin) { %>SEHATI Super Admin<% } else { %>SEHATI Admin Portal<% } %>
        <span class="sub"><% if (isSuperAdmin) { %>Audit · Pengawasan · Akun Admin<% } else { %>Akun Staf · Jadwal Praktek<% } %></span>
      </div>
    </div>

    <% if (isSuperAdmin) { %>
    <div class="sidebar-section" style="color:var(--admin);">Super Admin</div>
    <a href="/audit" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
      Overview Sistem
    </a>
    <a href="/audit/log" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="9" y1="15" x2="15" y2="15"></line></svg>
      Jejak Audit
    </a>
    <a href="/akun/admin" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
      Akun Admin
    </a>
    <div class="sidebar-section">Pengawasan (read-only)</div>
    <details class="nav-group" open>
      <summary>
        <span class="nav-group-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          Dashboard Admin
        </span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </summary>
      <div class="nav-sub">
        <a href="/admin" class="nav-item nav-sub-item active">Ringkasan</a>
        <a href="/jadwal" class="nav-item nav-sub-item">Jadwal Praktek</a>
        <a href="/akun/staf" class="nav-item nav-sub-item">Akun Staf</a>
        <a href="/spesialisasi" class="nav-item nav-sub-item">Spesialisasi</a>
      </div>
    </details>
    <details class="nav-group">
      <summary>
        <span class="nav-group-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          Dashboard Dokter
        </span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </summary>
      <div class="nav-sub">
        <a href="/antrian" class="nav-item nav-sub-item">Antrian Hari Ini</a>
      </div>
    </details>
    <details class="nav-group">
      <summary>
        <span class="nav-group-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          Front Desk
        </span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </summary>
      <div class="nav-sub">
        <a href="/kedatangan" class="nav-item nav-sub-item">Konfirmasi Kedatangan</a>
      </div>
    </details>
    <% } else { %>
    <div class="sidebar-section" style="color:var(--admin);">Admin</div>
    <a href="/admin" class="nav-item active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
      Ringkasan
    </a>
    <a href="/akun/staf" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
      Akun Tenaga Medis
    </a>
    <a href="/jadwal" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
      Jadwal Praktek
    </a>
    <a href="/spesialisasi" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
      Spesialisasi
    </a>
    <% } %>

    <div class="sidebar-footer">
      <a href="/auth/logout" class="logout-btn">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Keluar sesi
      </a>
    </div>
  </aside>

  <section class="main">
    <div class="main-topbar">
      <div class="searchbox">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" placeholder="Cari akun, jadwal…">
      </div>
      <div class="right-tools">
        <div class="user-chip">
          <span class="avatar" style="background:var(--admin-bg); color:var(--admin);"><%= user.nama.split(' ').map(w=>w[0]).join('').substring(0,2).toUpperCase() %></span>
          <div>
            <div class="user-name"><%= user.nama %></div>
            <div class="user-role"><%= isSuperAdmin ? 'Super Admin' : 'Admin' %></div>
          </div>
        </div>
      </div>
    </div>

    <div class="main-content">
      <% if (locals.flash_success) { %><div class="flash success"><%= flash_success %></div><% } %>
      <% if (locals.flash_error) { %><div class="flash error"><%= flash_error %></div><% } %>

      <div class="page-head">
        <div>
          <div class="meta">Admin</div>
          <h1>Ringkasan</h1>
        </div>
      </div>

      <div class="kpi-row" style="grid-template-columns: repeat(5, 1fr);">
        <div class="kpi-card">
          <div class="kpi-label">Dokter Aktif</div>
          <div class="kpi-value"><%= total_dokter %></div>
          <div class="kpi-meta"><a href="/akun/staf" style="color:var(--admin);">Kelola akun →</a></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Perawat Aktif</div>
          <div class="kpi-value"><%= total_perawat %></div>
          <div class="kpi-meta"><a href="/akun/staf" style="color:var(--admin);">Kelola akun →</a></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Resepsionis Aktif</div>
          <div class="kpi-value"><%= total_resepsionis %></div>
          <div class="kpi-meta"><a href="/akun/staf" style="color:var(--admin);">Kelola akun →</a></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Jadwal Aktif</div>
          <div class="kpi-value"><%= total_jadwal %></div>
          <div class="kpi-meta"><a href="/jadwal" style="color:var(--admin);">Kelola jadwal →</a></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">Spesialisasi</div>
          <div class="kpi-value"><%= total_spesialisasi %></div>
          <div class="kpi-meta"><a href="/spesialisasi" style="color:var(--admin);">Kelola →</a></div>
        </div>
      </div>

      <div style="display:grid; grid-template-columns: repeat(3,1fr); gap:16px; margin-top:8px;">
        <a href="/akun/staf" class="card" style="display:block; text-decoration:none; transition: box-shadow .15s;">
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
            <div style="width:36px; height:36px; border-radius:10px; background:var(--admin-bg); display:grid; place-items:center; flex-shrink:0;">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--admin)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
            </div>
            <strong style="font-size:15px;">Akun Tenaga Medis</strong>
          </div>
          <p class="muted" style="font-size:13px; margin:0;">Tambah, edit, dan nonaktifkan akun dokter, perawat, serta resepsionis.</p>
        </a>

        <a href="/jadwal" class="card" style="display:block; text-decoration:none; transition: box-shadow .15s;">
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
            <div style="width:36px; height:36px; border-radius:10px; background:var(--admin-bg); display:grid; place-items:center; flex-shrink:0;">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--admin)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
            <strong style="font-size:15px;">Jadwal Praktek</strong>
          </div>
          <p class="muted" style="font-size:13px; margin:0;">Atur jadwal praktek dokter per hari, jam, dan kuota pasien.</p>
        </a>

        <a href="/spesialisasi" class="card" style="display:block; text-decoration:none; transition: box-shadow .15s;">
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:10px;">
            <div style="width:36px; height:36px; border-radius:10px; background:var(--admin-bg); display:grid; place-items:center; flex-shrink:0;">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="var(--admin)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
            </div>
            <strong style="font-size:15px;">Spesialisasi</strong>
          </div>
          <p class="muted" style="font-size:13px; margin:0;">Kelola daftar spesialisasi yang tersedia di klinik.</p>
        </a>
      </div>
    </div>
  </section>
</div>
</body>
</html>
