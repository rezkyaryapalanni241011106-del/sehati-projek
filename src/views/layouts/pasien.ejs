<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · SEHATI</title>
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/patient.css">
  <link rel="stylesheet" href="/public/css/sehati.css">
</head>
<body>
<header class="topbar">
  <a class="logo" href="/">
    <span class="logo-mark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21.5 5 23 9 21.5 12.5 19 16.65 12 21 12 21z"></path></svg>
    </span>
    <span class="logo-text">SEHATI<span class="sub">RME</span></span>
  </a>
  <% if (locals.user) { %>
    <nav class="topnav">
      <a href="/pasien/dashboard" class="<%= locals.activeNav === 'dashboard' ? 'active' : '' %>">Dashboard</a>
      <a href="/pasien/booking" class="<%= locals.activeNav === 'booking' ? 'active' : '' %>">Booking</a>
      <a href="/pasien/riwayat" class="<%= locals.activeNav === 'riwayat' ? 'active' : '' %>">Riwayat</a>
    </nav>
    <div class="topbar-user">
      <span class="chip"><%= locals.user.nama %></span>
      <a class="back-link" href="/auth/pasien/logout">Keluar</a>
    </div>
  <% } else { %>
    <span class="chip">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21.5 5 23 9 21.5 12.5 19 16.65 12 21 12 21z"></path></svg>
      Klinik SEHATI · Rawat Jalan
    </span>
  <% } %>
</header>

<% if (locals.flash_success) { %>
  <div class="flash success" style="margin: 16px 28px 0;"><%= flash_success %></div>
<% } %>
<% if (locals.flash_error) { %>
  <div class="flash error" style="margin: 16px 28px 0;"><%= flash_error %></div>
<% } %>

<%- body %>

<footer class="app-footer">
  SEHATI · Institut Teknologi Bacharuddin Jusuf Habibie · Program Studi Rekayasa Perangkat Lunak.
</footer>
</body>
</html>
