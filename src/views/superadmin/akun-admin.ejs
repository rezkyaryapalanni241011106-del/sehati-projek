<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Akun Admin · SEHATI Super Admin</title>
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/medis.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <link rel="stylesheet" href="/public/css/sehati.css">
</head>
<body>
<div class="app-shell admin">
  <aside class="sidebar admin">
    <div class="sidebar-brand">
      <span class="logo-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21.5 5 23 9 21.5 12.5 19 16.65 12 21 12 21z"></path></svg>
      </span>
      <div class="brand-text">
        SEHATI Super Admin
        <span class="sub">Audit · Pengawasan · Akun Admin</span>
      </div>
    </div>

    <div class="sidebar-section" style="color:var(--admin);">Super Admin</div>
    <a href="/audit" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
      Overview Sistem
    </a>
    <a href="/audit/log" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="9" y1="15" x2="15" y2="15"></line></svg>
      Jejak Audit
    </a>
    <a href="/akun/admin" class="nav-item active">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
      Akun Admin
    </a>
    <a href="/auth/ubah-password" class="nav-item">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
      Ganti Password
    </a>
    <div class="sidebar-section">Pengawasan (read-only)</div>
    <details class="nav-group">
      <summary>
        <span class="nav-group-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          Dashboard Admin
        </span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </summary>
      <div class="nav-sub">
        <a href="/admin" class="nav-item nav-sub-item">Ringkasan</a>
        <a href="/jadwal" class="nav-item nav-sub-item">Jadwal Praktek</a>
        <a href="/akun/staf" class="nav-item nav-sub-item">Akun Staf</a>
        <a href="/spesialisasi" class="nav-item nav-sub-item">Spesialisasi</a>
      </div>
    </details>
    <details class="nav-group">
      <summary>
        <span class="nav-group-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          Dashboard Dokter
        </span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </summary>
      <div class="nav-sub">
        <a href="/antrian" class="nav-item nav-sub-item">Antrian Hari Ini</a>
      </div>
    </details>
    <details class="nav-group">
      <summary>
        <span class="nav-group-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          Front Desk
        </span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </summary>
      <div class="nav-sub">
        <a href="/kedatangan" class="nav-item nav-sub-item">Konfirmasi Kedatangan</a>
      </div>
    </details>

    <div class="sidebar-footer">
      <a href="/auth/logout" class="logout-btn">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Keluar sesi
      </a>
    </div>
  </aside>

  <section class="main">
    <div class="main-topbar">
      <div class="searchbox">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="topbarSearch" placeholder="Cari akun, log, jadwal…">
      </div>
      <div class="right-tools">
        <div class="user-chip">
          <span class="avatar" style="background:#f8eaea; color:var(--admin);"><%= user.nama.split(' ').map(w=>w[0]).join('').substring(0,2).toUpperCase() %></span>
          <div>
            <div class="user-name"><%= user.nama %></div>
            <div class="user-role">Super Admin</div>
          </div>
        </div>
      </div>
    </div>

    <div class="main-content">
      <% if (locals.flash_success) { %><div class="flash success"><%= flash_success %></div><% } %>
      <% if (locals.flash_error) { %><div class="flash error"><%= flash_error %></div><% } %>

      <div class="page-head">
        <div>
          <div class="meta">Manajemen Akun Admin</div>
          <h1>Akun Admin</h1>
        </div>
      </div>

      <div class="card card-padded" style="margin-bottom:18px;">
        <h3 style="margin-bottom:14px;"><%= edit ? 'Edit Admin' : 'Tambah Admin' %></h3>
        <form method="POST" action="<%= edit ? '/akun/admin/' + edit.id + '/update' : '/akun/admin' %>" class="form-grid">
          <div class="form-group">
            <label class="form-label">Username *</label>
            <input class="form-input" name="username" value="<%= edit ? edit.username : '' %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">Nama lengkap *</label>
            <input class="form-input" name="nama_lengkap" value="<%= edit ? edit.nama_lengkap : '' %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">Email *</label>
            <input class="form-input" type="email" name="email" value="<%= edit ? edit.email : '' %>" required>
          </div>
          <div class="form-group">
            <label class="form-label">Nomor HP</label>
            <input class="form-input" name="nomor_hp" value="<%= edit ? (edit.nomor_hp || '') : '' %>">
          </div>
          <% if (!edit) { %>
          <div class="form-group span-2">
            <label class="form-label">Password awal</label>
            <input class="form-input" name="password_custom" placeholder="kosong = auto-generate">
          </div>
          <% } %>
          <div class="form-actions span-2">
            <% if (edit) { %><a href="/akun/admin" class="back-link">Batal</a><% } %>
            <button class="btn btn-primary"><%= edit ? 'Simpan' : 'Tambah admin' %></button>
          </div>
        </form>
      </div>

      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr><th>Nama</th><th>Username</th><th>Email</th><th>Status</th><th>Aksi</th></tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <tr>
                <td><%= u.nama_lengkap %></td>
                <td class="tiny"><%= u.username %></td>
                <td class="tiny muted"><%= u.email %></td>
                <td><span class="badge badge-<%= u.status_aktif ? 'ringan' : 'kritis' %>"><%= u.status_aktif ? 'Aktif' : 'Nonaktif' %></span></td>
                <td class="aksi-cell" style="white-space:nowrap;">
                  <a class="back-link" href="/akun/admin/<%= u.id %>/edit">Edit</a>
                  <form method="POST" action="/akun/admin/<%= u.id %>/toggle" style="display:inline; margin:0;">
                    <button class="back-link" style="border:none; cursor:pointer;"><%= u.status_aktif ? 'Nonaktifkan' : 'Aktifkan' %></button>
                  </form>
                  <button class="back-link" style="border:none; cursor:pointer; background:none;"
                    onclick="bukaModalReset('<%= u.id %>', '<%= u.nama_lengkap %>')">Reset PW</button>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</div>

<!-- Modal Reset Password -->
<div id="modalReset" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:999; align-items:center; justify-content:center;">
  <div style="background:#fff; border-radius:12px; padding:28px 32px; width:100%; max-width:420px; box-shadow:0 8px 32px rgba(0,0,0,.18);">
    <h3 style="margin:0 0 4px;">Reset Password</h3>
    <p id="modalResetNama" style="margin:0 0 20px; color:var(--ink-soft); font-size:14px;"></p>
    <form id="formModalReset" method="POST" action="">
      <div class="form-group" style="margin-bottom:16px;">
        <label class="form-label">Password baru</label>
        <input class="form-input" type="text" name="password_custom" id="modalResetInput"
          placeholder="kosong = auto-generate" autocomplete="new-password">
        <div style="font-size:12px; color:var(--ink-soft); margin-top:6px;">Kosongkan untuk generate password acak otomatis.</div>
      </div>
      <div style="display:flex; gap:10px; justify-content:flex-end;">
        <button type="button" class="btn" style="background:var(--bg-soft);" onclick="tutupModalReset()">Batal</button>
        <button type="submit" class="btn btn-primary">Reset Password</button>
      </div>
    </form>
  </div>
</div>

<script>
function bukaModalReset(id, nama) {
  document.getElementById('formModalReset').action = '/akun/admin/' + id + '/reset-password';
  document.getElementById('modalResetNama').textContent = 'Akun: ' + nama;
  document.getElementById('modalResetInput').value = '';
  var modal = document.getElementById('modalReset');
  modal.style.display = 'flex';
  document.getElementById('modalResetInput').focus();
}
function tutupModalReset() {
  document.getElementById('modalReset').style.display = 'none';
}
document.getElementById('modalReset').addEventListener('click', function(e) {
  if (e.target === this) tutupModalReset();
});
</script>
<script src="/public/js/topbar-search.js"></script>
</body>
</html>
