<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Monitoring Antrian · SEHATI Super Admin</title>
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/medis.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <link rel="stylesheet" href="/public/css/sehati.css">
  <style>
    .monitor-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 14px;
      margin-bottom: 28px;
    }
    .dokter-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px 18px;
      cursor: pointer;
      transition: border-color .15s, box-shadow .15s;
      text-decoration: none;
      display: block;
      color: inherit;
    }
    .dokter-card:hover { border-color: var(--accent); box-shadow: 0 2px 8px rgba(0,0,0,.08); }
    .dokter-card.active { border-color: var(--accent); background: var(--accent-faint, #eff6ff); }
    .dokter-card-head { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
    .dokter-avatar {
      width: 36px; height: 36px; border-radius: 50%;
      background: var(--accent); color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-weight: 700; font-size: 14px; flex-shrink: 0;
    }
    .dokter-nama { font-weight: 600; font-size: 14px; line-height: 1.3; }
    .dokter-spesialis { font-size: 11px; color: var(--ink-soft); margin-top: 1px; }
    .stat-row { display: flex; gap: 6px; flex-wrap: wrap; margin-top: 4px; }
    .stat-chip {
      font-size: 11px; font-weight: 600; padding: 2px 8px; border-radius: 20px;
      display: inline-flex; align-items: center; gap: 4px;
    }
    .chip-hadir   { background: #dbeafe; color: #1e40af; }
    .chip-selesai { background: #dcfce7; color: #166534; }
    .chip-booked  { background: #fef9c3; color: #854d0e; }
    .chip-skip    { background: #fee2e2; color: #991b1b; }
    .chip-total   { background: var(--border); color: var(--ink-soft); }
    .progress-bar { height: 4px; border-radius: 2px; background: var(--border); margin-top: 8px; overflow: hidden; }
    .progress-fill { height: 100%; border-radius: 2px; background: var(--accent); transition: width .3s; }

    .section-title {
      font-size: 12px; font-weight: 600; color: var(--ink-soft);
      text-transform: uppercase; letter-spacing: .06em; margin-bottom: 12px;
    }
    .detail-header {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 10px; padding: 16px 20px; margin-bottom: 16px;
      display: flex; align-items: center; gap: 16px;
    }
    .detail-header .dokter-avatar { width: 44px; height: 44px; font-size: 16px; }
    .detail-title { font-size: 18px; font-weight: 700; }
    .detail-sub { font-size: 12px; color: var(--ink-soft); margin-top: 2px; }

    .antrian-table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .antrian-table th {
      text-align: left; padding: 8px 12px; background: var(--surface);
      border-bottom: 2px solid var(--border); font-size: 11px;
      text-transform: uppercase; letter-spacing: .05em; color: var(--ink-soft);
    }
    .antrian-table td { padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    .antrian-table tr:last-child td { border-bottom: none; }
    .antrian-table tr:hover td { background: var(--surface-hover, #f9fafb); }
    .badge-hadir  { color: #1e40af; font-weight: 600; }
    .badge-skip   { color: #991b1b; font-weight: 600; }
    .empty-state {
      text-align: center; padding: 40px 20px;
      color: var(--ink-soft); font-size: 14px;
    }
    .empty-icon { font-size: 32px; margin-bottom: 8px; }
    .tanggal-badge {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 6px; padding: 4px 10px; font-size: 12px;
      color: var(--ink-soft); font-weight: 600;
    }
    .back-link {
      display: inline-flex; align-items: center; gap: 6px;
      font-size: 12px; color: var(--accent); margin-bottom: 16px;
      text-decoration: none;
    }
    .back-link:hover { text-decoration: underline; }

    /* Summary bar at top */
    .summary-bar {
      display: flex; gap: 12px; margin-bottom: 24px; flex-wrap: wrap;
    }
    .summary-pill {
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 8px; padding: 12px 16px; min-width: 120px;
    }
    .summary-pill-label { font-size: 11px; color: var(--ink-soft); text-transform: uppercase; letter-spacing: .05em; }
    .summary-pill-value { font-size: 24px; font-weight: 700; line-height: 1; margin-top: 4px; }
    .summary-pill-value.blue   { color: #1d4ed8; }
    .summary-pill-value.green  { color: #16a34a; }
    .summary-pill-value.yellow { color: #a16207; }
    .summary-pill-value.red    { color: #dc2626; }
  </style>
</head>
<body>
<div class="app-shell admin">
  <!-- Sidebar sama dengan overview -->
  <aside class="sidebar admin">
    <div class="sidebar-brand">
      <span class="logo-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21.5 5 23 9 21.5 12.5 19 16.65 12 21 12 21z"></path></svg>
      </span>
      <div class="brand-text">
        SEHATI Super Admin
        <span class="sub">Audit · Pengawasan · Akun Admin</span>
      </div>
    </div>

    <div class="sidebar-section" style="color:var(--admin);">Super Admin</div>
    <a href="/audit" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path></svg>
      Overview Sistem
    </a>
    <a href="/audit/log" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="9" y1="15" x2="15" y2="15"></line></svg>
      Jejak Audit
    </a>
    <a href="/akun/admin" class="nav-item">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle></svg>
      Akun Admin
    </a>
    <div class="sidebar-section">Pengawasan (read-only)</div>
    <details class="nav-group">
      <summary>
        <span class="nav-group-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
          Dashboard Admin
        </span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </summary>
      <div class="nav-sub">
        <a href="/admin" class="nav-item nav-sub-item">Ringkasan</a>
        <a href="/jadwal" class="nav-item nav-sub-item">Jadwal Praktek</a>
        <a href="/akun/staf" class="nav-item nav-sub-item">Akun Staf</a>
        <a href="/spesialisasi" class="nav-item nav-sub-item">Spesialisasi</a>
      </div>
    </details>
    <details class="nav-group" open>
      <summary>
        <span class="nav-group-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
          Dashboard Dokter
        </span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </summary>
      <div class="nav-sub">
        <a href="/antrian" class="nav-item nav-sub-item active">Antrian Hari Ini</a>
      </div>
    </details>
    <details class="nav-group">
      <summary>
        <span class="nav-group-label">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
          Front Desk
        </span>
        <svg class="chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </summary>
      <div class="nav-sub">
        <a href="/kedatangan" class="nav-item nav-sub-item">Konfirmasi Kedatangan</a>
      </div>
    </details>

    <div class="sidebar-footer">
      <a href="/auth/logout" class="logout-btn">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
        Keluar sesi
      </a>
    </div>
  </aside>

  <section class="main">
    <div class="main-topbar">
      <div class="topbar-title">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
        Monitoring Antrian Hari Ini
      </div>
      <span class="tanggal-badge"><%= tanggal %></span>
    </div>

    <div class="main-content">
      <%
        const totalHadir   = semuaDokter.reduce((s, d) => s + Number(d.jumlah_hadir),   0);
        const totalSelesai = semuaDokter.reduce((s, d) => s + Number(d.jumlah_selesai), 0);
        const totalBooked  = semuaDokter.reduce((s, d) => s + Number(d.jumlah_booked),  0);
        const totalSkip    = semuaDokter.reduce((s, d) => s + Number(d.jumlah_skip),    0);
      %>
      <!-- Summary bar -->
      <div class="summary-bar">
        <div class="summary-pill">
          <div class="summary-pill-label">Dokter aktif</div>
          <div class="summary-pill-value"><%= semuaDokter.length %></div>
        </div>
        <div class="summary-pill">
          <div class="summary-pill-label">Sedang ditangani</div>
          <div class="summary-pill-value blue"><%= totalHadir %></div>
        </div>
        <div class="summary-pill">
          <div class="summary-pill-label">Selesai</div>
          <div class="summary-pill-value green"><%= totalSelesai %></div>
        </div>
        <div class="summary-pill">
          <div class="summary-pill-label">Menunggu</div>
          <div class="summary-pill-value yellow"><%= totalBooked %></div>
        </div>
        <div class="summary-pill">
          <div class="summary-pill-label">Di-skip</div>
          <div class="summary-pill-value red"><%= totalSkip %></div>
        </div>
      </div>

      <% if (!filterDokter) { %>
        <!-- ── Kartu per dokter ── -->
        <div class="section-title">Semua Dokter Aktif</div>
        <% if (semuaDokter.length === 0) { %>
          <div class="empty-state">
            <div class="empty-icon">🏥</div>
            <div>Belum ada dokter aktif terdaftar.</div>
          </div>
        <% } else { %>
          <div class="monitor-grid">
            <% semuaDokter.forEach(function(d) { %>
              <%
                const total   = Number(d.jumlah_total);
                const selesai = Number(d.jumlah_selesai);
                const pct     = total > 0 ? Math.round((selesai / total) * 100) : 0;
                const inisial = d.nama_dokter.split(' ').slice(0,2).map(w => w[0]).join('').toUpperCase();
              %>
              <a href="/antrian?dokter=<%= d.dokter_id %>" class="dokter-card">
                <div class="dokter-card-head">
                  <div class="dokter-avatar"><%= inisial %></div>
                  <div>
                    <div class="dokter-nama"><%= d.nama_dokter %></div>
                    <div class="dokter-spesialis"><%= d.spesialisasi || '—' %></div>
                  </div>
                </div>
                <div class="stat-row">
                  <span class="stat-chip chip-hadir">
                    <svg viewBox="0 0 10 10" width="8" height="8" fill="currentColor"><circle cx="5" cy="5" r="5"/></svg>
                    <%= d.jumlah_hadir %> hadir
                  </span>
                  <span class="stat-chip chip-selesai"><%= d.jumlah_selesai %> selesai</span>
                  <span class="stat-chip chip-booked"><%= d.jumlah_booked %> booked</span>
                  <% if (Number(d.jumlah_skip) > 0) { %>
                    <span class="stat-chip chip-skip"><%= d.jumlah_skip %> skip</span>
                  <% } %>
                </div>
                <% if (total > 0) { %>
                  <div class="progress-bar">
                    <div class="progress-fill" style="width:<%= pct %>%"></div>
                  </div>
                  <div style="font-size:10px; color:var(--ink-soft); margin-top:3px; text-align:right;">
                    <%= pct %>% selesai dari <%= total %> kunjungan
                  </div>
                <% } else { %>
                  <div style="font-size:11px; color:var(--ink-soft); margin-top:8px;">
                    Belum ada kunjungan hari ini
                  </div>
                <% } %>
              </a>
            <% }); %>
          </div>
        <% } %>

      <% } else { %>
        <!-- ── Detail antrian satu dokter ── -->
        <a href="/antrian" class="back-link">
          <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          Kembali ke semua dokter
        </a>

        <% if (dokterDipilih) { %>
          <%
            const inisialD = dokterDipilih.nama_dokter.split(' ').slice(0,2).map(w => w[0]).join('').toUpperCase();
          %>
          <div class="detail-header">
            <div class="dokter-avatar" style="width:44px;height:44px;font-size:16px;"><%= inisialD %></div>
            <div>
              <div class="detail-title"><%= dokterDipilih.nama_dokter %></div>
              <div class="detail-sub"><%= dokterDipilih.spesialisasi || 'Umum' %></div>
            </div>
            <div style="margin-left:auto; display:flex; gap:8px; flex-wrap:wrap;">
              <span class="stat-chip chip-hadir" style="font-size:13px; padding:4px 12px;"><%= dokterDipilih.jumlah_hadir %> hadir</span>
              <span class="stat-chip chip-selesai" style="font-size:13px; padding:4px 12px;"><%= dokterDipilih.jumlah_selesai %> selesai</span>
              <span class="stat-chip chip-booked" style="font-size:13px; padding:4px 12px;"><%= dokterDipilih.jumlah_booked %> booked</span>
              <% if (Number(dokterDipilih.jumlah_skip) > 0) { %>
                <span class="stat-chip chip-skip" style="font-size:13px; padding:4px 12px;"><%= dokterDipilih.jumlah_skip %> skip</span>
              <% } %>
            </div>
          </div>
        <% } %>

        <div class="section-title">Antrian Aktif (Hadir &amp; Skip)</div>
        <% if (detailAntrian.length === 0) { %>
          <div class="empty-state">
            <div class="empty-icon">✅</div>
            <div>Tidak ada pasien dengan status hadir atau skip saat ini.</div>
          </div>
        <% } else { %>
          <div style="background:var(--surface); border:1px solid var(--border); border-radius:10px; overflow:hidden;">
            <table class="antrian-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>Jam Slot</th>
                  <th>Nama Pasien</th>
                  <th>No. RM</th>
                  <th>Usia</th>
                  <th>Keluhan</th>
                  <th>Status</th>
                  <th>Konfirmasi</th>
                </tr>
              </thead>
              <tbody>
                <% detailAntrian.forEach(function(a, i) { %>
                  <tr>
                    <td style="color:var(--ink-soft);"><%= i + 1 %></td>
                    <td><strong><%= a.slot_jam ? a.slot_jam.substring(0,5) : '—' %></strong></td>
                    <td><%= a.nama_pasien %></td>
                    <td style="font-family:monospace; font-size:12px;"><%= a.nomor_rm %></td>
                    <td><%= a.usia ? a.usia + ' th' : '—' %></td>
                    <td style="max-width:200px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">
                      <%= a.keluhan_awal || '—' %>
                    </td>
                    <td>
                      <% if (a.status === 'hadir') { %>
                        <span class="badge-hadir">● Hadir</span>
                      <% } else { %>
                        <span class="badge-skip">● Skip</span>
                      <% } %>
                    </td>
                    <td style="color:var(--ink-soft); font-size:12px;">
                      <% if (a.waktu_konfirmasi) { %>
                        <%= new Date(a.waktu_konfirmasi).toLocaleTimeString('id-ID', {hour:'2-digit',minute:'2-digit'}) %>
                      <% } else { %>—<% } %>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      <% } %>
    </div>
  </section>
</div>
</body>
</html>
