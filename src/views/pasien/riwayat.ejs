<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Riwayat Kunjungan · SEHATI</title>
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/patient.css">
  <link rel="stylesheet" href="/public/css/sehati.css">
  <script>window.addEventListener('pageshow',function(e){if(e.persisted){document.documentElement.style.visibility='hidden';window.location.replace(window.location.href);}});</script>
  <style>
    .dash-container {
      max-width: 860px;
      margin: 0 auto;
      padding: 36px 24px 60px;
    }
    .dash-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 22px 24px;
    }
    .dash-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 4px;
    }
    .dash-card-head h3 { font-size: 16px; margin: 0; }

    /* Visit rows */
    .visit-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 14px 0;
      border-top: 1px solid var(--border-soft);
      gap: 16px;
      flex-wrap: wrap;
    }
    .visit-item:first-child { border-top: none; padding-top: 4px; }
    .visit-num {
      font-size: 12px;
      color: var(--ink-muted);
      font-weight: 700;
      width: 20px;
      flex-shrink: 0;
      text-align: center;
    }
    .visit-body { flex: 1; min-width: 0; }
    .visit-dx {
      font-size: 14px;
      font-weight: 600;
      color: var(--ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .visit-meta {
      font-size: 12px;
      color: var(--ink-soft);
      margin-top: 2px;
    }
    .visit-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }
    .empty-state {
      padding: 28px 0 8px;
      text-align: center;
      color: var(--ink-muted);
      font-size: 14px;
    }
    .empty-state a { color: var(--accent); font-weight: 600; }

    /* Status badge map */
    .status-booked  { color: var(--menengah); background: var(--menengah-bg); }
    .status-hadir   { color: var(--menengah); background: var(--menengah-bg); }
    .status-selesai { color: var(--ringan);   background: var(--ringan-bg); }
    .status-batal   { color: var(--kritis);   background: var(--kritis-bg); }
    .status-skip    { color: var(--ink-muted);background: var(--bg-soft); }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 999px;
    }
    .status-pill::before {
      content: "";
      width: 6px; height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .topbar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .topbar-user-text {
      font-size: 13px;
      color: var(--ink-soft);
      text-align: right;
      line-height: 1.3;
    }
    .topbar-user-text strong { color: var(--ink); display: block; }
  </style>
</head>
<body>
<header class="topbar">
  <a class="logo" href="/">
    <span class="logo-mark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21.5 5 23 9 21.5 12.5 19 16.65 12 21 12 21z"></path></svg>
    </span>
    <span class="logo-text">SEHATI<span class="sub">RME</span></span>
  </a>
  <nav class="topnav">
    <a href="/pasien/dashboard">Dashboard</a>
    <a href="/pasien/booking">Booking</a>
    <a href="/riwayat/pasien" class="active">Riwayat</a>
  </nav>
  <div class="topbar-right">
    <div class="topbar-user-text">
      <strong><%= user.nama %></strong>
    </div>
    <a class="back-link" href="/auth/pasien/logout" style="font-size:13px;">Keluar</a>
  </div>
</header>

<main>
  <div class="dash-container">

    <div style="margin-bottom:24px;">
      <div class="eyebrow">Portal Pasien</div>
      <h1 style="font-size:28px; margin:6px 0 0;">Riwayat Kunjungan</h1>
    </div>

    <div class="dash-card">
      <div class="dash-card-head">
        <h3>Semua Kunjungan</h3>
        <span class="tiny muted"><%= kunjungans.length %> kunjungan</span>
      </div>

      <% if (kunjungans.length === 0) { %>
        <div class="empty-state">
          Belum ada riwayat kunjungan. <a href="/pasien/booking">Buat booking →</a>
        </div>
      <% } else { %>
        <% kunjungans.forEach(function(k, i) { %>
        <%
          var statusClass = {booked:'status-booked', hadir:'status-hadir', selesai:'status-selesai', batal:'status-batal', skip:'status-skip'}[k.status] || 'status-skip';
          var statusText  = {booked:'Terjadwal', hadir:'Hadir', selesai:'Selesai', batal:'Dibatal', skip:'Dilewati'}[k.status] || k.status;
        %>
        <div class="visit-item">
          <span class="visit-num"><%= i + 1 %></span>
          <div class="visit-body">
            <div class="visit-dx">
              <%= k.dx_label ? k.dx_label : (k.status === 'selesai' ? 'Konsultasi Umum' : 'Janji Temu') %>
            </div>
            <div class="visit-meta">
              <%= new Date(k.tanggal).toLocaleDateString('id-ID', {day:'numeric', month:'long', year:'numeric'}) %>
              <% if (k.slot_jam) { %> · <%= k.slot_jam.substring(0,5) %><% } %>
              · dr. <%= k.nama_dokter %>
              <% if (k.spesialisasi) { %> · <em><%= k.spesialisasi %></em><% } %>
            </div>
          </div>
          <div class="visit-right">
            <span class="status-pill <%= statusClass %>"><%= statusText %></span>
            <% if (k.status === 'selesai') { %>
              <a href="/riwayat/pasien/<%= k.id %>" class="btn btn-ghost btn-sm">Detail</a>
              <% if (k.soap_id) { %>
                <a href="/resep/pasien/<%= k.soap_id %>/pdf" class="btn btn-ghost btn-sm" target="_blank">
                  <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
                  PDF
                </a>
              <% } %>
            <% } else if (k.status === 'booked') { %>
              <a href="/keluhan/<%= k.id %>" class="btn btn-ghost btn-sm">Isi Keluhan</a>
            <% } %>
          </div>
        </div>
        <% }); %>
      <% } %>
    </div>

  </div>
</main>
<footer class="app-footer">SEHATI · Sistem Elektronik Healthcare Anda Terintegrasi · Rekam Medis Elektronik sesuai Permenkes 24/2022.</footer>
<script src="/public/js/auth-guard.js"></script>
</body>
</html>
