<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Buat Janji Temu · SEHATI</title>
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/patient.css">
  <link rel="stylesheet" href="/public/css/sehati.css">
  </head>
<body>
<header class="topbar">
  <a class="logo" href="/">
    <span class="logo-mark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21.5 5 23 9 21.5 12.5 19 16.65 12 21 12 21z"></path></svg>
    </span>
    <span class="logo-text">SEHATI<span class="sub">RME</span></span>
  </a>
  <nav class="topnav">
    <a href="/pasien/dashboard">Dashboard</a>
    <a href="/pasien/booking" class="active">Booking</a>
    <a href="/riwayat/pasien">Riwayat</a>
  </nav>
  <div class="topbar-user">
    <span class="chip"><%= user.nama %></span>
    <a class="back-link" href="/auth/pasien/logout">Keluar</a>
  </div>
</header>

<main>
  <div class="container">
    <% if (locals.flash_error) { %><div class="flash error"><%= flash_error %></div><% } %>
    <% if (locals.flash_success) { %><div class="flash success"><%= flash_success %></div><% } %>

    <div class="page-head">
      <div>
        <div class="meta">Portal Pasien</div>
        <h1>Buat Janji Temu</h1>
      </div>
      <a href="/pasien/dashboard" class="back-link">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        Kembali
      </a>
    </div>

    <div class="booking-grid">
      <!-- Kolom kiri: Form Booking -->
      <div class="card card-padded">
        <form method="POST" action="/booking" id="formBooking">
          <input type="hidden" id="id_jadwal" name="id_jadwal">

          <div class="form-group">
            <label class="form-label">Tanggal Kunjungan *</label>
            <input type="date" id="tanggal" name="tanggal" class="form-input" required
                   min="<%= new Date().toISOString().split('T')[0] %>">
          </div>

          <div class="form-group">
            <label class="form-label">Spesialisasi</label>
            <select id="spesialisasi" class="form-input">
              <option value="">Semua Spesialisasi</option>
              <% spesialisasiList.forEach(function(s) { %>
                <option value="<%= s.id %>"><%= s.nama %></option>
              <% }); %>
            </select>
          </div>

          <div class="form-group" id="dokterGroup" style="display:none">
            <label class="form-label">Dokter *</label>
            <select id="id_dokter" name="id_dokter" class="form-input" required>
              <option value="">Pilih Dokter</option>
            </select>
          </div>

          <div class="form-group" id="slotGroup" style="display:none">
            <label class="form-label">Jam Kunjungan *</label>
            <div id="slotContainer" class="slot-grid" style="margin-top:10px;"></div>
            <input type="hidden" id="slot_jam" name="slot_jam" required>
          </div>

          <div class="form-group" style="margin-top:24px;">
            <button type="submit" class="btn btn-primary btn-block" id="btnSubmit" disabled>
              Konfirmasi Booking
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            </button>
          </div>
        </form>
      </div>

      <!-- Kolom kanan: Panel Jadwal Dokter -->
      <div class="panel-jadwal" id="panelJadwal">
        <div class="panel-jadwal-empty" id="panelEmpty">
          <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          Pilih dokter untuk melihat jadwal prakteknya
        </div>
        <div id="panelKonten" style="display:none">
          <div class="eyebrow" style="margin-bottom:8px;">Jadwal Praktek</div>
          <div class="panel-dokter-nama" id="panelNamaDokter"></div>
          <div class="panel-dokter-sp" id="panelSpesialisasi"></div>
          <ul class="panel-jadwal-list" id="panelJadwalList"></ul>
          <div class="panel-jadwal-durasi" id="panelDurasi"></div>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
(function() {
  const tanggalEl = document.getElementById('tanggal');
  const spesialisasiEl = document.getElementById('spesialisasi');
  const dokterSelect = document.getElementById('id_dokter');
  const dokterGroup = document.getElementById('dokterGroup');
  const slotGroup = document.getElementById('slotGroup');
  const slotContainer = document.getElementById('slotContainer');
  const slotJamInput = document.getElementById('slot_jam');
  const jadwalInput = document.getElementById('id_jadwal');
  const btnSubmit = document.getElementById('btnSubmit');
  const panelEmpty = document.getElementById('panelEmpty');
  const panelKonten = document.getElementById('panelKonten');
  const panelNamaDokter = document.getElementById('panelNamaDokter');
  const panelSpesialisasi = document.getElementById('panelSpesialisasi');
  const panelJadwalList = document.getElementById('panelJadwalList');
  const panelDurasi = document.getElementById('panelDurasi');

  async function loadDokter() {
    const t = tanggalEl.value, sp = spesialisasiEl.value;
    if (!t) return;
    const r = await fetch('/booking/dokter?tanggal=' + t + '&spesialisasi=' + sp);
    const data = await r.json();
    dokterSelect.innerHTML = '<option value="">Pilih Dokter</option>' +
      data.dokters.map(d => '<option value="' + d.id + '">' + d.nama_lengkap + (d.spesialisasi_nama ? ' · ' + d.spesialisasi_nama : '') + '</option>').join('');
    dokterGroup.style.display = data.dokters.length ? 'block' : 'none';
    slotGroup.style.display = 'none';
    btnSubmit.disabled = true;
    tampilkanPanelKosong();
  }

  async function loadSlots() {
    const t = tanggalEl.value, d = dokterSelect.value;
    if (!t || !d) { tampilkanPanelKosong(); return; }
    const r = await fetch('/booking/slots?id_dokter=' + d + '&tanggal=' + t);
    const data = await r.json();
    jadwalInput.value = data.jadwal_id || '';
    slotContainer.innerHTML = data.slots.map(s =>
      '<button type="button" class="slot ' + (s.tersedia ? 'slot-free' : 'slot-taken') + '"' +
      (s.tersedia ? ' data-jam="' + s.jam + '"' : ' disabled') +
      '>' + s.jam_display + '</button>'
    ).join('') || '<p class="muted">Tidak ada slot tersedia untuk hari ini.</p>';
    slotGroup.style.display = 'block';
    slotJamInput.value = '';
    btnSubmit.disabled = true;
    await loadInfoDokter(d);
  }

  async function loadInfoDokter(idDokter) {
    try {
      const r = await fetch('/booking/info-dokter?id_dokter=' + idDokter);
      const info = await r.json();
      if (!info) { tampilkanPanelKosong(); return; }
      panelNamaDokter.textContent = 'dr. ' + info.dokter.nama_lengkap;
      panelSpesialisasi.textContent = info.dokter.spesialisasi_nama || 'Dokter Umum';
      panelJadwalList.innerHTML = info.jadwal.map(j =>
        '<li class="panel-jadwal-item">' +
          '<span class="panel-jadwal-hari">' + j.hari + '</span>' +
          '<span class="panel-jadwal-jam">' + j.jam_mulai + ' – ' + j.jam_selesai + '</span>' +
        '</li>'
      ).join('');
      panelDurasi.textContent = 'Durasi per pasien: ' + info.jadwal[0].durasi_menit + ' menit';
      panelEmpty.style.display = 'none';
      panelKonten.style.display = 'block';
    } catch (e) {
      tampilkanPanelKosong();
    }
  }

  function tampilkanPanelKosong() {
    panelEmpty.style.display = 'flex';
    panelKonten.style.display = 'none';
  }

  slotContainer.addEventListener('click', function(e) {
    const btn = e.target.closest('button.slot-free[data-jam]');
    if (!btn) return;
    document.querySelectorAll('#slotContainer .slot-free').forEach(function(b) {
      b.classList.remove('slot-selected');
    });
    btn.classList.add('slot-selected');
    slotJamInput.value = btn.dataset.jam;
    btnSubmit.disabled = false;
  });

  tanggalEl.addEventListener('change', function() { loadDokter(); slotGroup.style.display = 'none'; });
  spesialisasiEl.addEventListener('change', loadDokter);
  dokterSelect.addEventListener('change', loadSlots);
})();
</script>
<script src="/public/js/auth-guard.js"></script>
</body>
</html>
