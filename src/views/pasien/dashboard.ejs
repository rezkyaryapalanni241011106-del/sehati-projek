<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard · SEHATI</title>
  <link rel="stylesheet" href="/public/css/base.css">
  <link rel="stylesheet" href="/public/css/patient.css">
  <link rel="stylesheet" href="/public/css/sehati.css">
  <style>
    .dash-container {
      max-width: 860px;
      margin: 0 auto;
      padding: 40px 24px 60px;
    }
    .dash-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }
    .dash-greeting {
      font-size: 32px;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin: 6px 0 4px;
    }
    .dash-sub {
      font-size: 14px;
      color: var(--ink-soft);
    }
    .dash-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 22px 24px;
      margin-bottom: 16px;
    }
    .dash-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }
    .dash-card-head h3 {
      font-size: 16px;
      margin: 0;
    }
    .dash-card-head a {
      font-size: 13px;
      color: var(--accent);
      font-weight: 600;
    }
    .dash-empty {
      color: var(--ink-muted);
      font-size: 14px;
      padding: 4px 0 2px;
    }
    .dash-empty a { color: var(--accent); font-weight: 600; }
    .visit-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-top: 1px solid var(--border-soft);
      gap: 12px;
      flex-wrap: wrap;
    }
    .visit-row:first-child { border-top: none; padding-top: 0; }
    .visit-dx { font-size: 14px; font-weight: 600; color: var(--ink); }
    .visit-meta { font-size: 12px; color: var(--ink-soft); margin-top: 2px; }
    .visit-actions { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }

    .upcoming-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 10px 14px;
      background: var(--bg-soft);
      border-radius: var(--radius);
      margin-bottom: 8px;
      gap: 12px;
      flex-wrap: wrap;
    }
    .upcoming-row:last-child { margin-bottom: 0; }
    .upcoming-date {
      font-size: 13px;
      font-weight: 700;
      color: var(--ink);
    }
    .upcoming-meta {
      font-size: 12px;
      color: var(--ink-soft);
      margin-top: 1px;
    }
    .upcoming-actions { display: flex; gap: 8px; align-items: center; flex-shrink: 0; }

    .topbar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .topbar-user-text {
      font-size: 13px;
      color: var(--ink-soft);
      text-align: right;
      line-height: 1.3;
    }
    .topbar-user-text strong { color: var(--ink); display: block; }
  </style>
</head>
<body>
<header class="topbar">
  <a class="logo" href="/">
    <span class="logo-mark">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.35-9.5-8.5C1 9 2.5 5 6.5 5 9 5 12 8 12 8s3-3 5.5-3C21.5 5 23 9 21.5 12.5 19 16.65 12 21 12 21z"></path></svg>
    </span>
    <span class="logo-text">SEHATI<span class="sub">RME</span></span>
  </a>
  <nav class="topnav">
    <a href="/pasien/dashboard" class="active">Dashboard</a>
    <a href="/pasien/booking">Booking</a>
    <a href="/riwayat/pasien">Riwayat</a>
  </nav>
  <div class="topbar-right">
    <div class="topbar-user-text">
      <strong><%= pasien ? pasien.nama_lengkap : user.nama %></strong>
      <% if (pasien) { %><span><%= pasien.nomor_rm %></span><% } %>
    </div>
    <a class="back-link" href="/auth/logout" style="font-size:13px;">Keluar</a>
  </div>
</header>

<main>
  <div class="dash-container">
    <% if (locals.flash_success) { %><div class="alert alert-success" style="margin-bottom:20px;"><%= flash_success %></div><% } %>
    <% if (locals.flash_error) { %><div class="alert alert-warning" style="margin-bottom:20px;"><%= flash_error %></div><% } %>

    <% if (!pasien) { %>
      <div class="alert alert-info" style="margin-bottom:20px;">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        <div>Data profil belum lengkap. <a href="/pasien/profil" style="font-weight:600;">Lengkapi sekarang →</a></div>
      </div>
    <% } %>

    <div class="dash-header">
      <div>
        <div class="eyebrow">Ringkasan</div>
        <div class="dash-greeting">Halo, <%= pasien ? pasien.nama_lengkap.split(' ')[0] : user.nama.split(' ')[0] %> 👋</div>
        <div class="dash-sub">
          <% if (pasien) { %>No. RM <strong><%= pasien.nomor_rm %></strong> · <%= hitungUsia(pasien.tanggal_lahir) %> tahun<% } %>
        </div>
      </div>
      <a href="/pasien/booking" class="btn btn-primary" style="flex-shrink:0; margin-top:4px;">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Booking Kunjungan
      </a>
    </div>

    <!-- Kunjungan Mendatang -->
    <div class="dash-card">
      <div class="dash-card-head">
        <h3>Kunjungan Mendatang</h3>
        <a href="/pasien/booking">+ Tambah</a>
      </div>
      <% if (mendatang.length === 0) { %>
        <p class="dash-empty">Belum ada kunjungan terjadwal. <a href="/pasien/booking">Buat booking →</a></p>
      <% } else { %>
        <% mendatang.forEach(function(k) { %>
        <div class="upcoming-row">
          <div>
            <div class="upcoming-date">
              <%= new Date(k.tanggal).toLocaleDateString('id-ID', {weekday:'long', day:'numeric', month:'long', year:'numeric'}) %>
              · <%= k.slot_jam ? k.slot_jam.substring(0,5) : '' %>
            </div>
            <div class="upcoming-meta">dr. <%= k.nama_dokter %><% if (k.spesialisasi) { %> · <%= k.spesialisasi %><% } %></div>
          </div>
          <div class="upcoming-actions">
            <% const statusLabel = {booked:'Terjadwal', hadir:'Hadir'}; %>
            <span class="badge badge-menengah"><%= statusLabel[k.status] || k.status %></span>
            <% if (k.status === 'booked') { %>
              <a href="/keluhan/<%= k.id %>" class="btn btn-ghost btn-sm">Keluhan</a>
              <form method="POST" action="/booking/<%= k.id %>/batal" style="display:inline;"
                    onsubmit="return confirm('Yakin ingin membatalkan janji ini?')">
                <button class="btn btn-danger btn-sm">Batal</button>
              </form>
            <% } %>
          </div>
        </div>
        <% }); %>
      <% } %>
    </div>

    <!-- Riwayat Terakhir -->
    <div class="dash-card">
      <div class="dash-card-head">
        <h3>Riwayat Terakhir</h3>
        <a href="/riwayat/pasien">Lihat semua</a>
      </div>
      <% if (riwayat.length === 0) { %>
        <p class="dash-empty">Belum ada riwayat kunjungan selesai.</p>
      <% } else { %>
        <% riwayat.forEach(function(k) { %>
        <div class="visit-row">
          <div>
            <div class="visit-dx"><%= k.dx_label || 'Konsultasi Umum' %></div>
            <div class="visit-meta">
              <%= new Date(k.tanggal).toLocaleDateString('id-ID', {day:'numeric', month:'short', year:'numeric'}) %>
              · dr. <%= k.nama_dokter %>
            </div>
          </div>
          <div class="visit-actions">
            <a href="/riwayat/pasien/<%= k.id %>" class="btn btn-ghost btn-sm">Detail</a>
          </div>
        </div>
        <% }); %>
      <% } %>
    </div>

  </div>
</main>
<footer class="app-footer">SEHATI · Sistem Elektronik Healthcare Anda Terintegrasi · Rekam Medis Elektronik sesuai Permenkes 24/2022.</footer>
</body>
</html>
